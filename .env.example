# ── Local Vite (`npm run dev`) ───────────────────────────────
# Leave blank to use the Vite proxy (/api and /ws → localhost:8000),
# or point directly at the backend:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_BASE_URL=ws://localhost:8000
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# ── Vercel production (HTTPS → HTTPS/WSS via nip.io) ─────────
# Set these in the Vercel project Environment Variables.
# No custom DNS: use nip.io for the AWS VM public IP
# (13.60.91.88 → 13-60-91-88.nip.io). Never use http:// or ws:// here.
# VITE_API_BASE_URL=https://13-60-91-88.nip.io
# VITE_WS_BASE_URL=wss://13-60-91-88.nip.io
# (If VITE_WS_BASE_URL is omitted, wss:// is derived from VITE_API_BASE_URL.)

VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
